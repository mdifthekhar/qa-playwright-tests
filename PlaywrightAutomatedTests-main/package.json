{
  "name": "belletire-automation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js web/features/**/*.feature --require web/features/steps/**/*.ts --require-module ts-node/register --format json:reports/json/cucumber_report.json",
    "test:parallel": "cucumber-js web/features/**/*.feature --require web/features/steps/**/*.ts --require-module ts-node/register --parallel 4 --format json:reports/json/cucumber_report.json",
    "test:smoke": "cucumber-js web/features/**/*.feature --require web/features/steps/**/*.ts --require-module ts-node/register --tags @smoke --format json:reports/json/cucumber_report.json",
    "test:regression": "cucumber-js web/features/**/*.feature --require web/features/steps/**/*.ts --require-module ts-node/register --tags @regression --format json:reports/json/cucumber_report.json",
    "test:failed": "cucumber-js @rerun.txt --require web/features/steps/**/*.ts --require-module ts-node/register --format json:reports/json/cucumber_report.json",
    "report": "npx multiple-cucumber-html-reporter --reportPath ./reports/html --jsonDir ./reports/json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@playwright/test": "^1.48.2",
    "@types/node": "^20.12.7",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "cucumber-html-reporter": "^6.0.0",
    "dotenv": "^16.4.5",
    "multiple-cucumber-html-reporter": "^3.0.1",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.48.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@types/moment": "^2.13.0",
    "cucumber": "^6.0.7",
    "moment": "^2.30.1"
  },
  "description": ""
}
